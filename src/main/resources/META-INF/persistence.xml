<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="Programacion2">
        <!-- Una línea por cada clase que se guarda en la base -->
        <class>com.programacion2.dominio.Persona</class>
        <class>com.programacion2.dominio.Empleado</class>
        <class>com.programacion2.dominio.Socio</class>
        <class>com.programacion2.dominio.Plan</class>
        <class>com.programacion2.dominio.Actividad</class>
        <class>com.programacion2.dominio.Pago</class>
        <class>com.programacion2.dominio.Ingreso</class>
        <exclude-unlisted-classes/>

        <properties>
            <property name="javax.jdo.option.ConnectionDriverName"
                      value="com.mysql.cj.jdbc.Driver"/>
            <property name="javax.jdo.option.ConnectionURL"
                      value="jdbc:mysql://localhost:3306/gimnasio?allowPublicKeyRetrieval=true&amp;useSSL=false"/>
            <property name="javax.jdo.option.ConnectionUserName"
                      value="gimnasio"/>
            <!-- La contraseña NO se sube a GitHub: la pone Configuracion
                 desde la variable de entorno DB_PASSWORD (ver README). -->

            <!-- Crea las tablas y columnas que falten al arrancar -->
            <property name="datanucleus.schema.autoCreateAll" value="true"/>
            <!-- Niveles de relaciones que se traen al consultar -->
            <property name="datanucleus.maxFetchDepth" value="2"/>
        </properties>
    </persistence-unit>
</persistence>
